{
  "name": "pinefall-engine",
  "version": "0.5.2",
  "private": true,
  "type": "module",
  "main": "build-desktop/main.mjs",
  "scripts": {
    "dev": "bun --bun vite --host 0.0.0.0",
    "build": "bun run check && bun --bun vite build",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --deny-warnings",
    "format": "oxfmt --write .",
    "check": "bun run typecheck && bun run lint",
    "test": "bun test tests",
    "preview": "bun --bun vite preview --host 0.0.0.0",
    "desktop:build": "bun run build && bun scripts/desktop.ts",
    "desktop": "bun run desktop:build && electron .",
    "desktop:linux": "bun run desktop:build && electron-builder --linux AppImage",
    "desktop:windows": "bun run desktop:build && electron-builder --win zip",
    "test:browser": "bun tests/browser.ts",
    "test:runtime-browser": "bun tests/runtime-browser.ts",
    "game": "bun scripts/game.ts",
    "test:scripting-browser": "bun tests/scripting-browser.ts",
    "test:workspace": "bun tests/workspace-browser.ts",
    "test:color-picker": "bun tests/color-browser.ts",
    "test:ui": "bun tests/ui-browser.ts",
    "test:pif": "bun tests/pif-browser.ts"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.19.3",
    "@fontsource/dm-sans": "5.3.0",
    "@fontsource/space-grotesk": "5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "node-liblzma": "5.1.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sucrase": "3.35.0",
    "three": "^0.185.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/bun": "^1.4.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "electron": "45.2.1",
    "electron-builder": "26.18.0",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "typescript": "^7.0.2",
    "vite": "^7.3.7"
  },
  "packageManager": "bun@1.4.4",
  "build": {
    "appId": "org.pinefall.engine",
    "productName": "Pinefall Engine",
    "directories": {
      "output": "build/releases"
    },
    "files": [
      "dist/**/*",
      "build-desktop/**/*",
      "package.json",
      "!node_modules/**/*",
      "docs/licenses/**/*",
      "THIRD_PARTY.md",
      "docs/PIF.md"
    ],
    "linux": {
      "target": "AppImage",
      "category": "Development",
      "icon": "public/pinefall-app-icon.png"
    },
    "win": {
      "target": "zip",
      "icon": "desktop/icon.ico"
    },
    "npmRebuild": false
  }
}
