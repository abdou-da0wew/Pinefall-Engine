{
  "name": "pinefall-engine",
  "version": "0.7.0",
  "private": true,
  "type": "module",
  "main": "build-desktop/main.mjs",
  "scripts": {
    "dev": "bun scripts/prepare-language-service.ts && bun --bun vite --host 0.0.0.0",
    "build": "bun run check && bun scripts/prepare-language-service.ts && bun scripts/build-vite.ts",
    "typecheck": "bun node_modules/typescript/bin/tsc --noEmit",
    "lint": "oxlint --deny-warnings",
    "format": "oxfmt --write .",
    "check": "bun run typecheck && bun run lint",
    "test": "bun test tests",
    "preview": "bun --bun vite preview --host 0.0.0.0",
    "desktop:build": "bun run build && bun scripts/desktop.ts",
    "desktop": "bun run desktop:build && electron .",
    "desktop:linux": "bun run desktop:build && electron-builder --linux AppImage",
    "desktop:windows": "bun run desktop:build && electron-builder --win zip",
    "test:browser": "bun tests/browser.ts",
    "test:runtime-browser": "bun tests/runtime-browser.ts",
    "game": "bun scripts/game.ts",
    "test:scripting-browser": "bun tests/scripting-browser.ts",
    "test:workspace": "bun tests/workspace-browser.ts",
    "test:color-picker": "bun tests/color-browser.ts",
    "test:ui": "bun tests/ui-browser.ts",
    "test:pif": "bun tests/pif-browser.ts",
    "test:assets": "bun tests/assets-browser.ts",
    "test:assets-native": "bun tests/assets-native.ts",
    "dev:animation-audio": "bun scripts/animation-audio-lab.ts",
    "test:animation-audio": "bun tests/animation-audio-browser.ts",
    "test:animator": "bun tests/animator-browser.ts",
    "test:root-motion": "bun tests/root-motion-browser.ts",
    "generate:animation-audio": "bun scripts/generate-animation-audio-workshop.ts",
    "test:authored-audio": "bun tests/authored-audio-browser.ts",
    "test:animation-audio-export": "bun tests/animation-audio-export.ts",
    "test:streaming-audio": "bun tests/streaming-audio-browser.ts",
    "test:home": "bun tests/home-browser.ts && bun tests/home-projects-browser.ts && bun tests/home-storage-browser.ts",
    "test:home-native": "TEST_NATIVE=1 xvfb-run -a bun tests/home-browser.ts",
    "test:commands": "bun tests/commands-browser.ts",
    "test:disk-assets": "bun tests/disk-assets-browser.ts && bun tests/lazy-library-browser.ts",
    "test:player-handoff": "bun tests/player-handoff-browser.ts",
    "test:graphics-native": "xvfb-run -a bun tests/graphics-native.ts",
    "test:large-model": "bun tests/large-model-browser.ts",
    "test:plan03": "bun tests/plan03-browser.ts && bun tests/shader-browser.ts && bun tests/plan03-editor.ts",
    "generate:shader-reference": "bun scripts/generate-shader-reference.ts",
    "generate:materials-reference": "bun scripts/generate-materials-reference.ts",
    "hooks:install": "bun scripts/install-hooks.ts",
    "prepare": "bun scripts/install-hooks.ts",
    "test:shader-files": "bun tests/shader-files-browser.ts",
    "test:unified-sources-native": "xvfb-run -a bun tests/unified-sources-native.ts",
    "test:graphics-completion": "bun tests/graphics-images-browser.ts && bun tests/material-slots-browser.ts && bun tests/material-maps-browser.ts && bun tests/scattering-browser.ts && bun tests/scattering-advanced-browser.ts && bun tests/graphics-failures-browser.ts && bun tests/environment-browser.ts && bun tests/plan03-browser.ts && bun tests/shader-browser.ts",
    "test:graphics-authoring-native": "xvfb-run -a bun tests/graphics-authoring-native.ts"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.19.3",
    "@fontsource/dm-sans": "5.3.0",
    "@fontsource/space-grotesk": "5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "node-liblzma": "5.1.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sucrase": "3.35.0",
    "three": "0.185.0",
    "typescript-language-service": "npm:typescript@5.9.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/bun": "^1.4.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "0.185.0",
    "electron": "45.2.1",
    "electron-builder": "26.18.0",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "typescript": "^7.0.2",
    "vite": "^7.3.7"
  },
  "packageManager": "bun@1.4.4",
  "build": {
    "appId": "org.pinefall.engine",
    "productName": "Pinefall Engine",
    "directories": {
      "output": "build/releases"
    },
    "files": [
      "dist/**/*",
      "build-desktop/**/*",
      "package.json",
      "!node_modules/**/*",
      "docs/licenses/**/*",
      "THIRD_PARTY.md",
      "docs/PIF.md"
    ],
    "linux": {
      "target": "AppImage",
      "category": "Development",
      "icon": "public/pinefall-app-icon.png"
    },
    "win": {
      "target": "zip",
      "icon": "desktop/icon.ico"
    },
    "npmRebuild": false
  }
}
